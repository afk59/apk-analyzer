.idea/
.claude/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- inputs
# Test corpus binaries. Large (one is 328 MB) and not ours to redistribute;
# every other input the tool needs to RUN is tracked.
*.apk
*.apkm
*.xapk
*.ipa
*.dll
*.exe

# ---------------------------------------------------------------- outputs
# Everything under result/ is regenerated by a run.
src/result/
*.html
*.xlsx
*.metadata
# result archives
*.rar
*.zip

# ---------------------------------------------------------------- exceptions
# The four data files below are ANALYSIS INPUTS caught by the blanket rules
# above. Without them a fresh clone silently degrades: the API index cannot be
# rebuilt, OHPM package existence cannot be checked, and an offline batch shows
# "No internet connection" instead of real Play metadata. All are tracked
# deliberately -- see "What a clone needs" in README.md.
!src/data/reference/hmos_api.xlsx
!src/data/reference/ohpm_registry_cache.json
!src/data/reference/play_metadata_cache.json
