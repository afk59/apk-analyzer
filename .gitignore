.idea/
.claude/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- inputs
# Test corpus binaries, and anything the downloader fetches. Large, and not
# ours to redistribute; every other input the tool needs to RUN is tracked.
*.apk
*.apkm
*.xapk
*.ipa
*.dll
*.exe

# ---------------------------------------------------------------- outputs
# Everything under result/ is regenerated by a run.
engine/result/
*.html
*.xlsx
*.metadata
# result archives
*.rar
*.zip

# ---------------------------------------------------------------- v2 state
# The SQLite file is an INDEX (see docs/decisions/0002): every row is derivable
# from an artifact on disk, so it is rebuilt by a rescan and never committed.
app/store/*.db
app/store/*.db-wal
app/store/*.db-shm

# ---------------------------------------------------------------- exceptions
# Analysis INPUTS caught by the blanket rules above. Without them a fresh clone
# silently degrades: the API index cannot be rebuilt, OHPM package existence
# cannot be checked, and an offline batch shows "No internet connection"
# instead of real Play metadata. See "What a clone needs" in README.md.
!engine/data/reference/hmos_api.xlsx
!engine/data/reference/ohpm_registry_cache.json
!engine/data/reference/play_metadata_cache.json

# The frontend is hand-written and MUST stay tracked -- *.html above would
# otherwise swallow the entire UI.
!app/web/**/*.html
