.idea/
.claude/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- inputs
# Test corpus binaries, and anything the downloader fetches. Large, and not
# ours to redistribute; every other input the tool needs to RUN is tracked.
*.apk
*.apkm
*.xapk
*.ipa
*.dll
*.exe

# ---------------------------------------------------------------- outputs
# Everything under result/ is regenerated by a run.
engine/result/
*.html
*.xlsx
*.metadata
# result archives
*.rar
*.zip

# ---------------------------------------------------------------- v2 state
# The SQLite file is an INDEX: every row is derivable
# from an artifact on disk, so it is rebuilt by a rescan and never committed.
app/store/*.db
app/store/*.db-wal
app/store/*.db-shm

# ---------------------------------------------------------------- exceptions
# Analysis input caught by the blanket rules above: without it an offline
# batch shows "No internet connection" instead of real Play metadata.
!engine/data/reference/play_metadata_cache.json

# The frontend is hand-written and MUST stay tracked -- *.html above would
# otherwise swallow the entire UI.
!app/web/**/*.html
